rules_version = '2';

// ServiceHub – Firestore security rules.
// These run on Google's servers, so they protect the data even if someone
// changes the app. Paste this whole file into:
// Firebase Console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers

    // Someone is logged in.
    function signedIn() {
      return request.auth != null;
    }

    // The logged-in person's own users/{uid} document.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // The logged-in person is the admin (role set by hand in the Console).
    function isAdmin() {
      return signedIn() && me().role == 'admin';
    }

    // Logged in AND not blocked by the admin. Used for every normal write.
    function active() {
      return signedIn() && me().isBlocked != true;
    }

    // An update changes ONLY these fields (anything else is refused).
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // This person is the customer or the provider of that booking.
    function isOnBooking(bookingId, uid) {
      let b = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return b.customerId == uid || b.providerId == uid;
    }

    // ------------------------------------------------------------ users

    match /users/{uid} {
      // Any logged-in person may read user documents
      // (needed to hide blocked providers and for the admin lists).
      allow read: if signedIn();

      // Register: you may create only YOUR OWN document, as customer or provider
      // (never admin), and not already blocked. The admin also creates sample providers.
      // (The own-document check comes first: a new user has no document yet,
      //  so the admin check can't be the first thing we look at.)
      allow create: if (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['customer', 'provider']
        && request.resource.data.isBlocked == false
      ) || isAdmin();

      // Edit profile: only your own name, phone, area and address.
      // You can never change your own role or blocked status. The admin can change anything.
      allow update: if isAdmin() || (
        active() && request.auth.uid == uid
        && onlyChanges(['name', 'phone', 'area', 'address', 'email', 'savedAddresses', 'favoriteProviderIds', 'fcmToken', 'fcmTokenAt'])
        // email only to the one Firebase Login itself confirmed (after the link in the email was tapped)
        && (request.resource.data.email == resource.data.email || request.resource.data.email == request.auth.token.email)
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------ providers

    match /providers/{uid} {
      allow read: if signedIn();

      // Register as provider: your own document, always starting as PENDING with zero stats.
      allow create: if (
        signedIn() && request.auth.uid == uid
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.ratingCount == 0
        && request.resource.data.jobsCompleted == 0
        && request.resource.data.totalEarnings == 0
      ) || isAdmin();

      allow update: if isAdmin()
        // The provider: profile and availability switch. NOT approvalStatus (only the admin approves).
        || (active() && request.auth.uid == uid
            && onlyChanges(['name', 'phone', 'area', 'bio', 'experienceYears',
                            'isAvailable', 'offDays', 'extraWorkDates']))
        // Completing a job: exactly +1 job, and earnings can only go UP (by at most one job's
        // biggest possible bill: service + up to 10 extras of ₹50,000). So no fake totals.
        || (active() && request.auth.uid == uid
            && onlyChanges(['jobsCompleted', 'totalEarnings'])
            && request.resource.data.jobsCompleted == resource.data.jobsCompleted + 1
            && request.resource.data.totalEarnings >= resource.data.totalEarnings
            && request.resource.data.totalEarnings <= resource.data.totalEarnings + 600000)
        // A customer leaving a review: exactly ONE more rating, and the average stays 1 to 5.
        || (active() && onlyChanges(['ratingAvg', 'ratingCount'])
            && request.resource.data.ratingCount == resource.data.ratingCount + 1
            && request.resource.data.ratingAvg >= 1 && request.resource.data.ratingAvg <= 5);

      allow delete: if false;
    }

    // ------------------------------------------------------------ categories

    match /categories/{categoryId} {
      // Anyone may read categories, even before logging in (the Register screen needs
      // them for the provider's "Service category" list). They contain nothing private.
      allow read: if true;
      // Only the admin adds, hides or shows categories.
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ services (catalog)

    match /services/{serviceId} {
      allow read: if signedIn();
      // Only the admin adds services, edits prices, or hides/shows them.
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ coupons

    match /coupons/{code} {
      // Any logged-in customer may check a code; only the admin creates or turns them on/off.
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ bookings

    match /bookings/{bookingId} {
      // Private: only the booking's own customer, its provider, or the admin can read it
      // (it contains an address and phone numbers).
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.providerId == request.auth.uid
        || isAdmin()
      );

      // A customer creates a booking for themselves, always starting as REQUESTED.
      allow create: if active()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'REQUESTED'
        // A discount is only allowed with a coupon that really exists and is active.
        && (request.resource.data.get('discount', 0) == 0
            || get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.isActive == true);

      // Only the booking's own customer or its assigned provider (or the admin) can change it,
      // and each side may change ONLY its own fields. The app's transactions make sure only
      // the allowed status moves happen.
      allow update: if isAdmin()
        // The CUSTOMER: cancel, reschedule (back to REQUESTED), pay online, rate, ask for a redo.
        // They can never set COMPLETED / IN_PROGRESS, change prices, or mark cash as collected.
        || (active() && resource.data.customerId == request.auth.uid
            && onlyChanges(['status', 'cancelReason', 'date', 'timeSlot', 'acceptedAt', 'updatedAt',
                            'paymentStatus', 'paymentMode', 'paymentId', 'paidAt', 'isRated',
                            'revisitStatus', 'revisitReason', 'revisitRequestedAt', 'revisitPin',
                            'requestedAt', 'noAnswerNotified'])
            // Status: unchanged, or (only while still Requested/Accepted) cancel or reschedule back to Requested
            && (request.resource.data.status == resource.data.status
                || (resource.data.status in ['REQUESTED', 'ACCEPTED']
                    && request.resource.data.status in ['CANCELLED', 'REQUESTED']))
            // "Paid" by the customer only with an online payment id
            && (request.resource.data.paymentStatus == resource.data.paymentStatus
                || request.resource.data.paymentId != ''))
        // The PROVIDER: accept / reject / start / complete / cancel, on-the-way, extras,
        // cash collected, redo done. They can never change the PINs, the customer or the price list.
        || (active() && resource.data.providerId == request.auth.uid
            && onlyChanges(['status', 'rejectReason', 'cancelReason', 'acceptedAt', 'startedAt',
                            'completedAt', 'updatedAt', 'onTheWayAt', 'paymentStatus', 'paymentMode',
                            'paidAt', 'extraItems', 'extraAmount', 'totalAmount',
                            'revisitStatus', 'revisitDoneAt']));

      allow delete: if false;

      // Chat inside this booking: only its customer and its provider.
      // You may only send messages as yourself (max 500 characters). Messages are never edited or deleted.
      match /messages/{messageId} {
        allow read: if signedIn() && isOnBooking(bookingId, request.auth.uid);
        allow create: if active() && isOnBooking(bookingId, request.auth.uid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------ slots (busy markers)

    // One document per provider + date + slot that is booked. No personal details inside.
    // The app creates it in the same transaction as the booking, so two customers can never
    // hold the same slot.
    match /slots/{slotId} {
      // Anyone logged in may check if a slot is busy.
      allow read: if signedIn();

      // A customer claims a slot for their own booking (or the provider, when accepting).
      allow create: if active() && (request.resource.data.customerId == request.auth.uid
                                    || request.resource.data.providerId == request.auth.uid);

      // Changing a slot:
      //  - its provider marks it "accepted" (Booked) when accepting the request;
      //  - another customer may take it over ONLY if it was never accepted and its
      //    1-hour hold is over (the provider did not answer in time).
      allow update: if active() && (
        (resource.data.providerId == request.auth.uid
          && request.resource.data.providerId == request.auth.uid)
        || (request.resource.data.customerId == request.auth.uid
          && resource.data.get('accepted', false) == false
          && resource.data.get('heldUntil', 9999999999999) < request.time.toMillis())
      );

      // Freed by the booking's customer (cancel/reschedule) or provider (reject/complete).
      // "resource == null" allows deleting a slot that was never created (older bookings).
      allow delete: if resource == null || isAdmin() || (
        active() && (resource.data.customerId == request.auth.uid
                     || resource.data.providerId == request.auth.uid)
      );
    }

    // ------------------------------------------------------------ reviews

    match /reviews/{reviewId} {
      allow read: if signedIn();

      // Only the customer, once per booking (review id = booking id), 1 to 5 stars.
      allow create: if active()
        && request.resource.data.customerId == request.auth.uid
        && reviewId == request.resource.data.bookingId
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

      // Reviews cannot be edited or deleted.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ complaints ("Report a problem")

    match /complaints/{complaintId} {
      // The customer who reported it, or the admin.
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());

      // A customer reports a problem about their OWN booking, always starting as OPEN.
      allow create: if active()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'OPEN'
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId
             == request.auth.uid;

      // Only the admin marks it resolved. Nobody deletes complaints.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ------------------------------------------------------------ notifications

    match /notifications/{notificationId} {
      // You can read only your own notifications.
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      // The admin can send any notification. Everyone else only about a booking they
      // belong to, and only to the other person on that booking (or themselves).
      allow create: if isAdmin() || (
        active()
        && request.resource.data.bookingId != ''
        && isOnBooking(request.resource.data.bookingId, request.auth.uid)
        && isOnBooking(request.resource.data.bookingId, request.resource.data.userId)
      );

      // You can only mark your own notifications as read.
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && onlyChanges(['isRead']);

      allow delete: if false;
    }
  }
}
